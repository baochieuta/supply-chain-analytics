# Data (raw data can be large / from Kaggle - don't commit, document how to get it instead)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Models (can be large binary files)
models/*.pkl
models/*.joblib
!models/.gitkeep

# OS/editor
.DS_Store
.vscode/
.idea/

# Environment
.env
